<Window x:Class="SteamSaveSync.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SteamSaveSync" Height="720" Width="1200" MinHeight="600" MinWidth="900">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="SteamSaveSync" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Automatic save discovery and two-way synchronization" Opacity="0.65" Margin="0,4,0,16"/></StackPanel>
 <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16"><Button Content="Scan Steam" Width="130" Height="36" Click="ScanSteam_Click"/><Button Content="Enable Selected" Width="130" Height="36" Margin="10,0,0,0" Click="EnableSelected_Click"/><Button Content="Start Auto Sync" Width="130" Height="36" Margin="10,0,0,0" Click="StartAutoSync_Click"/><Button Content="Stop Auto Sync" Width="130" Height="36" Margin="10,0,0,0" Click="StopAutoSync_Click"/><Button Content="Sync Now" Width="110" Height="36" Margin="10,0,0,0" Click="SyncNow_Click"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="18,0,0,0" Text="Ready"/></StackPanel>
 <DataGrid Grid.Row="2" x:Name="GamesGrid" AutoGenerateColumns="False" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="90"/><DataGridTextColumn Header="Save Status" Binding="{Binding SaveStatus}" Width="150"/><DataGridCheckBoxColumn Header="Sync" Binding="{Binding SyncEnabled}" Width="70"/><DataGridTextColumn Header="Sync Status" Binding="{Binding SyncStatus}" Width="170"/></DataGrid.Columns></DataGrid>
 <TextBlock Grid.Row="3" x:Name="SummaryText" Margin="0,14,0,0" Text="No scan has been run." Opacity="0.7"/>
 </Grid>
</Window>