<Window x:Class="SteamSaveSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamSaveSync" Height="720" Width="1100" MinHeight="600" MinWidth="850">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SteamSaveSync" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Automatic Steam game save discovery and synchronization" Opacity="0.65" Margin="0,4,0,16" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Scan Steam" Width="130" Height="36" Click="ScanSteam_Click" />
            <Button Content="Sync Now" Width="110" Height="36" Margin="10,0,0,0" IsEnabled="False" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="18,0,0,0" Text="Ready" />
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="GamesGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="100" />
                <DataGridTextColumn Header="Steam Library" Binding="{Binding LibraryPath}" Width="2*" />
                <DataGridTextColumn Header="Save Status" Binding="{Binding SaveStatus}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="SummaryText" Margin="0,14,0,0" Text="No scan has been run." Opacity="0.7" />
    </Grid>
</Window>
