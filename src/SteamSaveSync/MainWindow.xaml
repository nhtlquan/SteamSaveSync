<Window x:Class="SteamSaveSync.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SteamSaveSync" Height="760" Width="1200"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="SteamSaveSync" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Manual Steam save synchronization" Opacity="0.65" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><TextBlock Text="Shared folder:" VerticalAlignment="Center"/><TextBox x:Name="SharedPathBox" Width="620" Margin="10,0,10,0"/><Button Content="Browse..." Width="100" Click="BrowseShared_Click"/></StackPanel></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14"><Button Content="Scan Steam" Width="120" Height="36" Click="ScanSteam_Click"/><Button Content="Enable Selected" Width="125" Height="36" Margin="10,0,0,0" Click="EnableSelected_Click"/><Button Content="① Save → Shared" Width="150" Height="36" Margin="10,0,0,0" Click="Export_Click"/><Button Content="② Get Data" Width="120" Height="36" Margin="10,0,0,0" Click="RefreshShared_Click"/><Button Content="③ Shared → Save" Width="160" Height="36" Margin="10,0,0,0" Click="Restore_Click"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="18,0,0,0" Text="Ready"/></StackPanel><DataGrid Grid.Row="2" x:Name="GamesGrid" AutoGenerateColumns="False" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="AppID" Binding="{Binding AppId}" Width="90"/><DataGridTextColumn Header="Save Status" Binding="{Binding SaveStatus}" Width="150"/><DataGridCheckBoxColumn Header="Include" Binding="{Binding SyncEnabled}" Width="70"/><DataGridTextColumn Header="Status" Binding="{Binding SyncStatus}" Width="170"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" x:Name="SummaryText" Margin="0,14,0,0" Text="Manual mode: nothing is copied until you press a button." Opacity="0.7"/></Grid></Window>