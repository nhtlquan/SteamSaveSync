<Window x:Class="SteamSaveSync.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SteamSaveSync" Height="820" Width="1280" Background="#0B1020" Foreground="#F4F7FF">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Background" Value="#1C2745"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#344568"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style TargetType="TabItem"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="22,12"/></Style>
</Window.Resources>
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SteamSaveSync" FontSize="30" FontWeight="Bold"/><TextBlock Text="Manual game save transfer over your local network" Foreground="#91A0BE" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#111A30" CornerRadius="14" Padding="16,10"><TextBlock Text="● Manual Mode" Foreground="#63E6BE" FontWeight="Bold"/></Border></Grid>
 <TabControl Grid.Row="1" Margin="0,24,0,12" Background="#11182A">
  <TabItem Header="🎮  Games">
   <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#121C31" CornerRadius="14" Padding="14"><DockPanel><StackPanel Orientation="Horizontal"><Button Content="Scan Steam" Click="ScanSteam_Click" Background="#5B7CFA"/><Button Content="Save Game → C:\SteamSaveSync" Click="Export_Click" Background="#146C94"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#AAB8D4" Text="Ready"/></DockPanel></Border>
    <DataGrid Grid.Row="1" x:Name="GamesGrid" Margin="0,14,0,0" AutoGenerateColumns="False" Background="#101827" Foreground="White" BorderThickness="0" CanUserAddRows="False" RowHeight="64">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="Logo" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding LogoUrl}" Width="120" Height="48" Stretch="UniformToFill"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*"/>
      <DataGridTextColumn Header="Last Save Time" Binding="{Binding LastSaveDisplay}" Width="180"/>
      <DataGridTextColumn Header="Save" Binding="{Binding SaveStatus}" Width="150"/>
      <DataGridCheckBoxColumn Header="Include" Binding="{Binding SyncEnabled}" Width="80"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </TabItem>
  <TabItem Header="🖥  Devices">
   <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#121C31" CornerRadius="14" Padding="16"><StackPanel Orientation="Horizontal"><TextBox x:Name="DeviceNameBox" Width="240" Margin="4" Padding="10" Text="MSI Claw 8 AI+"/><TextBox x:Name="DeviceIpBox" Width="180" Margin="4" Padding="10" Text="192.168.1."/><Button Content="+ Add Device" Click="AddDevice_Click" Background="#5B7CFA"/></StackPanel></Border>
    <DataGrid Grid.Row="1" x:Name="DevicesGrid" Margin="0,14,0,14" AutoGenerateColumns="False" Background="#101827" Foreground="White" BorderThickness="0" CanUserAddRows="False">
     <DataGrid.Columns><DataGridTextColumn Header="Device Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="LAN IP" Binding="{Binding IpAddress}" Width="180"/><DataGridTextColumn Header="Remote Folder" Binding="{Binding RemoteSharePath}" Width="280"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/></DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="2" Background="#121C31" CornerRadius="14" Padding="14"><StackPanel Orientation="Horizontal"><Button Content="⬇ Get Data From Selected Device" Click="GetDeviceData_Click" Background="#146C94"/><Button Content="🔄 Sync C:\SteamSaveSync → Game Saves" Click="Restore_Click" Background="#5B7CFA"/><TextBlock x:Name="DeviceStatusText" VerticalAlignment="Center" Margin="14,0" Foreground="#AAB8D4" Text="Select a device, then get data."/></StackPanel></Border>
   </Grid>
  </TabItem>
 </TabControl>
 <TextBlock Grid.Row="2" x:Name="SummaryText" Foreground="#7E8DAA" Text="Storage: C:\SteamSaveSync"/>
</Grid>
</Window>